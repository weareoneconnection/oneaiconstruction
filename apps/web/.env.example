# ---------------------------------------------------------------------------
# Public — safe to expose in the browser bundle.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://oneaiconstruction.com

# Point these at first-party subdomains before launch. Vendor origins
# (*.vercel.app, *.up.railway.app) must never appear in public marketing.
NEXT_PUBLIC_CONSTRUCTION_OS_URL=https://os.oneaiconstruction.com
NEXT_PUBLIC_CONSTRUCTION_TWIN_URL=https://twin.oneaiconstruction.com
NEXT_PUBLIC_ONEAI_FORGE_URL=https://oneaiforge.com

NEXT_PUBLIC_CONTACT_EMAIL=hello@oneaiconstruction.com

# Construction Twin public demo endpoint. When set, the Ask Twin panel and the
# forecast strip upgrade to live product output after the page has rendered.
# Leave blank and the site shows its representative sample data instead — the
# layout is identical either way, so an outage is invisible to visitors.
# See the product repo's docs/PUBLIC_DEMO.md.
NEXT_PUBLIC_TWIN_DEMO_API=

# Construction OS public demo endpoint. When set, the proof page shows live
# prediction accuracy and the OS product page shows the live cost position.
# Both panels are absent — not empty — when this is unset or unreachable.
# See the OS repo's docs/PUBLIC_DEMO.md.
NEXT_PUBLIC_OS_DEMO_API=

# Cookieless analytics. Leave blank to disable entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ---------------------------------------------------------------------------
# Server only — never prefixed with NEXT_PUBLIC.
# Configure at least one delivery channel, or every demo request is dropped.
# ---------------------------------------------------------------------------

# Channel 1: email via Resend
RESEND_API_KEY=
LEAD_INBOX=sales@oneaiconstruction.com
LEAD_FROM=OneAI Construction <notifications@oneaiconstruction.com>

# Channel 2: webhook (Slack, HubSpot, Zapier, n8n)
LEAD_WEBHOOK_URL=
