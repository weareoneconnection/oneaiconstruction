{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start --workspace apps/web",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/zh",
        "http://localhost:3000/en/products/construction-twin",
        "http://localhost:3000/zh/products/construction-twin",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/zh/resources/project-world-model"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "color-contrast": "error",
        "meta-description": "error",
        "document-title": "error",
        "hreflang": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
